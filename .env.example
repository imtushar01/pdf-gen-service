# ─────────────────────────────────────────────────────────────────────────────
# PDF Generation Service — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong random key: openssl rand -hex 32
# The Django ERP must send this in the X-API-Key header with every request.
API_KEY=change-this-to-a-random-32-char-secret

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker Compose value (matches docker-compose.yml)
DATABASE_URL=postgresql://pdfuser:pdfpass@localhost:5432/pdfdb

# ── Redis / Queue ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Artifact Storage ──────────────────────────────────────────────────────────
# Directory where generated PDFs and ZIPs are stored.
# In production, replace this with an S3-compatible storage adapter.
ARTIFACTS_DIR=./artifacts

# ── Rendering ─────────────────────────────────────────────────────────────────
# Max concurrent Puppeteer renders.
# 4 × ~400 MB = ~1.6 GB peak rendering memory.
# Do not set higher than available RAM allows (minus OS and other processes).
RENDER_CONCURRENCY=4

# Puppeteer render timeout in milliseconds (30 seconds default).
RENDER_TIMEOUT_MS=30000

# Documents with more line items than this are split into chunks before rendering.
# Prevents OOM errors for 500+ line-item documents.
RENDER_CHUNK_SIZE=100
