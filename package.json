{
  "name": "pdf-gen-service",
  "version": "1.0.0",
  "description": "PDF generation microservice for ERP — invoices and purchase orders",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "worker": "node dist/worker",
    "worker:dev": "ts-node -r tsconfig-paths/register src/worker.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration": "jest --testPathPatterns='integration' --forceExit --no-coverage",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "7.4.2",
    "@prisma/client": "^5.22.0",
    "archiver": "^7.0.1",
    "bullmq": "^5.34.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "handlebars": "^4.7.8",
    "joi": "17.13.3",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^23.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.22",
    "@types/archiver": "^6.0.3",
    "@types/express": "4.17.21",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "22.15.3",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "eslint": "9.27.0",
    "jest": "29.7.0",
    "prettier": "3.5.3",
    "prisma": "^5.22.0",
    "source-map-support": "0.5.21",
    "supertest": "7.1.0",
    "ts-jest": "29.3.4",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3"
  }
}
